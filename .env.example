# Server
PORT=8080
ENV=development
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgres://workbuddy:workbuddy@127.0.0.1:5433/workbuddy?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (used in Shift 1 auth — fill before testing OAuth)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OAuth — Google
# Create a Google OAuth app in Google Cloud Console and set the redirect URL there.
# Example redirect URL for local development:
# http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# OAuth — GitHub
# Create a GitHub OAuth app and set the callback URL in GitHub settings.
# Example redirect URL for local development:
# http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Frontend (OAuth redirect after login)
# Set this to the frontend URL that will receive the auth tokens after login.
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# WebSocket (GET /rooms/{id}/ws)
# Comma-separated browser origins allowed to connect, e.g.
# https://app.example.com,http://localhost:3000
# Empty = any origin, but only when ENV=development.
WS_ALLOWED_ORIGINS=http://localhost:3000

# Task timer extension
# How long the user has to answer the "need more time?" prompt after a task
# timer ends, and how many extensions a task may get.
EXTENSION_PROMPT_TIMEOUT=60s
EXTENSION_MAX_COUNT=3

# Chat rate limit (POST /rooms/{id}/messages)
# Messages per user per window, across all rooms. 0 disables the limit.
# Over the limit the API answers 429 with Retry-After. If Redis is down,
# messages are allowed.
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW=10s

# Registration rate limit (POST /auth/register)
# Requests per client IP per window. 0 disables the limit. Over the limit
# the API answers 429 with Retry-After. If Redis is down, requests are allowed.
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=10m

# Client IP behind a reverse proxy
# Header whose first value is the real client IP, e.g. X-Forwarded-For.
# Empty = use the connection address (right when there is no proxy). Only set
# it when the API is reachable solely through a proxy that overwrites the
# header, otherwise clients can spoof their IP.
TRUSTED_PROXY_HEADER=

# LiveKit (POST /rooms/{id}/call/token)
# Server URL handed to clients and the API key/secret used to sign call
# tokens. Leave any of them empty to disable calls (the endpoint returns 503).
# The secret stays on the server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
