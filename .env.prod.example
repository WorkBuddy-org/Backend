# Production settings for docker-compose.prod.yml.
# Copy to .env.prod (git-ignored), fill in every REQUIRED value, keep it
# readable only by the deploy user (chmod 600 .env.prod). Never commit it.
# Values are taken literally: no quotes, no spaces around "=".
# Generate secrets with: openssl rand -hex 32

# --- Used by docker-compose.prod.yml itself ---------------------------------

# REQUIRED. Public hostname of the API; Caddy gets its TLS certificate for it.
DOMAIN=api.example.com
# REQUIRED. Postgres superuser created on the first start of the volume.
POSTGRES_USER=workbuddy
# REQUIRED. Postgres password; use URL-safe characters (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=CHANGE_ME
# REQUIRED. Database created on the first start of the volume.
POSTGRES_DB=workbuddy

# --- Read by the app (internal/config) ---------------------------------------

# REQUIRED. Must be "production": enforces the OAuth and frontend settings.
ENV=production
# Optional. HTTP port inside the container; Caddy proxies to app:8080.
PORT=8080
# Optional. debug | info | warn | error.
LOG_LEVEL=info

# REQUIRED. Same user/password/db as above; host "postgres" is the compose service.
DATABASE_URL=postgres://workbuddy:CHANGE_ME@postgres:5432/workbuddy?sslmode=disable
# REQUIRED. Host "redis" is the compose service (not exposed to the internet).
REDIS_URL=redis://redis:6379/0

# REQUIRED. Signs access tokens; long random value (openssl rand -hex 32).
JWT_SECRET=CHANGE_ME
# Optional. Access token lifetime.
JWT_ACCESS_TTL=15m
# Optional. Refresh token lifetime.
JWT_REFRESH_TTL=720h

# REQUIRED. Google OAuth client ID (Google Cloud Console > Credentials).
GOOGLE_CLIENT_ID=
# REQUIRED. Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# REQUIRED. Must match the redirect URI registered at Google exactly.
GOOGLE_REDIRECT_URL=https://api.example.com/auth/google/callback

# REQUIRED. GitHub OAuth App client ID (GitHub > Settings > Developer settings).
GITHUB_CLIENT_ID=
# REQUIRED. GitHub OAuth App client secret.
GITHUB_CLIENT_SECRET=
# REQUIRED. Must match the app's "Authorization callback URL" exactly.
GITHUB_REDIRECT_URL=https://api.example.com/auth/github/callback

# REQUIRED. Frontend page that receives the tokens after OAuth login.
FRONTEND_CALLBACK_URL=https://app.example.com/auth/callback

# REQUIRED. Comma-separated frontend origins allowed to open WebSockets.
WS_ALLOWED_ORIGINS=https://app.example.com

# Optional. Time to answer the "need more time?" prompt before removal.
EXTENSION_PROMPT_TIMEOUT=60s
# Optional. Maximum timer extensions per task.
EXTENSION_MAX_COUNT=3

# Optional. Chat messages per user per window; 0 disables the limit.
CHAT_RATE_LIMIT=10
# Optional. Chat rate-limit window.
CHAT_RATE_WINDOW=10s

# Optional. POST /auth/register requests per client IP per window; 0 disables.
REGISTER_RATE_LIMIT=5
# Optional. Registration rate-limit window.
REGISTER_RATE_WINDOW=10m
# Set by docker-compose.prod.yml to X-Forwarded-For (the app sits behind
# Caddy); a value here is overridden. Leave empty when running without a proxy.
TRUSTED_PROXY_HEADER=X-Forwarded-For

# REQUIRED for calls (otherwise POST /rooms/{id}/call/token returns 503).
# LiveKit Cloud project URL, e.g. wss://your-project.livekit.cloud
LIVEKIT_URL=
# REQUIRED for calls. LiveKit API key.
LIVEKIT_API_KEY=
# REQUIRED for calls. LiveKit API secret; stays on the server.
LIVEKIT_API_SECRET=
